{
	"name": "adt/doctrine-loggable",
	"type": "library",
	"description": "Logging of changes in Doctrine entities",
	"keywords": ["logging", "doctrine2"],
	"homepage": "https://github.com/AppsDevTeam/DoctrineLoggable",
	"license": ["BSD-3-Clause", "GPL-2.0", "GPL-3.0"],
	"authors": [
		{
			"name": "Apps Dev Team",
			"homepage": "http://appsdevteam.com",
			"email": "hello@appsdevteam.com"
		}
	],
	"support": {
		"email": "hello@appsdevteam.com",
		"issues": "https://github.com/AppsDevTeam/DoctrineLoggable/issues"
	},
	"require": {
		"php": "^8.0|^8.1|^8.2",
		"nette/utils": "^2.5|^3.0|^4.0",
		"nette/di": "^3.0",
		"doctrine/orm": "^3.0",
		"doctrine/common": "^3.5",
		"nette/security": "^3.2"
	},
	"autoload": {
		"psr-4": {
			"ADT\\DoctrineLoggable\\": "src/",
			"Adt\\DoctrineLoggable\\": "src/"
		},
		"classmap": [
			"src/exceptions.php"
		]
	},
	"require-dev": {
		"phpunit/phpunit": "^11.5 | ^12.0 | ^13.0",
		"symfony/cache": "^6.0 | ^7.0",
		"symfony/var-exporter": "^6.4 | ^7.0",
		"symfony/console": "^6.0 | ^7.0"
	},
	"autoload-dev": {
		"psr-4": {
			"ADT\\DoctrineLoggable\\Tests\\": "tests/"
		}
	},
	"suggest": {
		"symfony/console": "To run doctrine-loggable:convert-legacy-change-sets, the migration of change sets stored by version 3"
	}
}
